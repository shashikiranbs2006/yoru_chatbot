# ==============================================================
# Yoru RAG Chatbot - Environment Variables
# ==============================================================

# ── Core AI API Keys (Required) ──────────────────────────────
# Get your Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ── Vector Database - ChromaDB ───────────────────────────────
# Local Docker default: http://localhost:8000
# For Vercel deployment: Set this to your hosted Chroma instance
# (e.g. Railway, Render, Fly.io, or Chroma Cloud URL)
CHROMA_URL=http://localhost:8000

# ── Session & Security (Required in Production) ───────────────
# Generate any long random string: e.g. openssl rand -base64 32
SESSION_SECRET=your_super_secret_session_key_here

# ── Google OAuth 2.0 (Optional - Guest login is supported) ───
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# For Local Development:
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
APP_URL=http://localhost:4000

# For Vercel Production Deployment:
# GOOGLE_CALLBACK_URL=https://your-app.vercel.app/auth/google/callback
# APP_URL=https://your-app.vercel.app
